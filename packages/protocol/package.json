{
  "name": "@dsh-rc/protocol",
  "version": "2.0.0",
  "description": "Wire protocol for DSH Remote Control: sealed-record crypto, KDF, pairing URI, control frames, payload catalog, keep-awake command builder. Pure functions — no I/O, no timers, no platform symbols.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./frames": {
      "types": "./dist/src/frames.d.ts",
      "default": "./dist/src/frames.js"
    },
    "./ids": {
      "types": "./dist/src/ids.d.ts",
      "default": "./dist/src/ids.js"
    },
    "./payloads": {
      "types": "./dist/src/payloads.d.ts",
      "default": "./dist/src/payloads.js"
    },
    "./outbound": {
      "types": "./dist/src/outbound.d.ts",
      "default": "./dist/src/outbound.js"
    },
    "./pairing": {
      "types": "./dist/src/pairing.d.ts",
      "default": "./dist/src/pairing.js"
    },
    "./record": {
      "types": "./dist/src/record.d.ts",
      "default": "./dist/src/record.js"
    },
    "./keys": {
      "types": "./dist/src/keys.d.ts",
      "default": "./dist/src/keys.js"
    },
    "./sleep": {
      "types": "./dist/src/sleep.d.ts",
      "default": "./dist/src/sleep.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test \"dist/tests/*.test.js\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
