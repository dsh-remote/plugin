{
  "name": "dsh-remote-control",
  "version": "0.1.0",
  "description": "Remote control for DeepSeek Harness — DSH plugin (Host) + zero-knowledge relay server + WeChat Mini Program client, with keep-awake.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/bundle-protocol.mjs",
    "test": "pnpm build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@dsh-rc/protocol": "workspace:*",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.12"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
