{
  "name": "dsh-remote-wire",
  "version": "1.0.0",
  "description": "Wire protocol for DSH Remote Control: sealed-record crypto, KDF, pairing URI, control frames, payload catalog, keep-awake command builder. Pure functions — no I/O, no timers, no platform symbols.",
  "type": "module",
  "license": "MIT",
  "author": "providcc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/providcc/dsh-remote-protocol.git"
  },
  "homepage": "https://github.com/providcc/dsh-remote-protocol#readme",
  "bugs": {
    "url": "https://github.com/providcc/dsh-remote-protocol/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "remote-control",
    "protocol",
    "e2ee",
    "tweetnacl",
    "x25519",
    "xsalsa20-poly1305"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./frames": {
      "types": "./dist/src/wire/frames.d.ts",
      "default": "./dist/src/wire/frames.js"
    },
    "./payloads": {
      "types": "./dist/src/wire/payloads.d.ts",
      "default": "./dist/src/wire/payloads.js"
    },
    "./outbound": {
      "types": "./dist/src/wire/outbound.d.ts",
      "default": "./dist/src/wire/outbound.js"
    },
    "./keys": {
      "types": "./dist/src/crypto/keys.d.ts",
      "default": "./dist/src/crypto/keys.js"
    },
    "./record": {
      "types": "./dist/src/crypto/record.d.ts",
      "default": "./dist/src/crypto/record.js"
    },
    "./pairing": {
      "types": "./dist/src/identity/pairing.d.ts",
      "default": "./dist/src/identity/pairing.js"
    },
    "./ids": {
      "types": "./dist/src/identity/ids.d.ts",
      "default": "./dist/src/identity/ids.js"
    },
    "./sleep": {
      "types": "./dist/src/platform/sleep.d.ts",
      "default": "./dist/src/platform/sleep.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/tests/**/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.7.0"
}
