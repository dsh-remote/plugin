{
  "name": "dsh-remote-control",
  "version": "1.0.0",
  "description": "DSH Remote Control host plugin: pairs a running DeepSeek Harness with the DRC relay so a WeChat Mini Program can send prompts, watch streamed output, and answer approvals. Payload-level E2E encryption; the relay never sees plaintext.",
  "type": "module",
  "license": "MIT",
  "author": "providcc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/providcc/dsh-remote-control.git"
  },
  "homepage": "https://github.com/providcc/dsh-remote-control#readme",
  "bugs": "https://github.com/providcc/dsh-remote-control/issues",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "remote-control",
    "cordis",
    "plugin",
    "e2ee",
    "tweetnacl",
    "x25519",
    "xsalsa20-poly1305"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/bundle/index.js",
  "exports": {
    ".": "./dist/bundle/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json && node ../../scripts/bundle-plugin.mjs",
    "test": "pnpm build && node --test \"dist/tests/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dsh-remote-wire": "^1.0.0",
    "qrcode": "^1.5.4",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.27.7",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.7.0"
}
