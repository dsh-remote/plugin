# 构建产物
dist/
# 依赖
node_modules/
# 包管理器的缓存/日志
.pnpm-store/
*.log
npm-debug.log*
pnpm-debug.log*
# 编辑器与系统
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
# 覆盖率
coverage/
# 配对通道密钥簿落盘：里面是全部历史会话的 PSK（见 src/shell/pair-store.ts）。
# 真机落点在 ~/.dsh 下不进任何仓库；这条防的是 e2e / 脚本把工作目录指到仓库里。
conversations-*.json
conversations-*.json.tmp-*
