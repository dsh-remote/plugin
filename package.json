{
  "name": "dsh-remote-control",
  "private": true,
  "version": "0.1.0",
  "description": "Remote control for DeepSeek Harness: DSH plugin (Host) + self-hostable relay server + WeChat Mini Program client. Payload-level end-to-end encrypted.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "e2e": "node e2e/run.mjs",
    "check:mp-ui": "node scripts/check-mp-ui.mjs && node scripts/check-mp-contrast.mjs",
    "mp:lazyload": "node scripts/mp-lazyload-report.mjs",
    "mp:theme": "node scripts/gen-mp-theme.mjs",
    "mp:shots": "node scripts/mp-shots.mjs",
    "mp:probe": "node scripts/mp-probe.mjs",
    "mp:upload": "node scripts/mp-upload.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
