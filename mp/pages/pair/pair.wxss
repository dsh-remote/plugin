/* pair 页：布局节奏 + 警示卡（组件内部样式由 TDesign 提供） */

.warn-card {
  background: var(--td-error-color-1, #fdeceb);
  border: 2rpx solid var(--td-error-color-3, #f5c6c0);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.warn-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: var(--td-error-color-6, #d54941);
}

.btn-gap {
  margin-top: 24rpx;
}

.hint {
  margin-top: 16rpx;
  text-align: center;
}

.hint.ok {
  color: var(--td-success-color, #2ba471);
}

.footer-link {
  margin-top: 32rpx;
  text-align: center;
  color: var(--td-brand-color, #0052d9);
  font-size: 26rpx;
  padding: 12rpx;
}

.footer-link.dim {
  color: var(--td-text-color-placeholder, #a0a6b0);
  font-size: 24rpx;
  margin-top: 12rpx;
}
