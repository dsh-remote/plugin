<view class="container">

  <view class="card">
    <view class="row-between">
      <text class="card-title">主机状态</text>
      <text wx:if="{{status === 'online'}}" class="tag tag-ok">在线</text>
      <text wx:else class="tag tag-idle">{{statusText || '离线'}}</text>
    </view>
    <view class="switch-row">
      <text class="label">防休眠（运行中保持不睡）</text>
      <switch checked="{{keepAwake && keepAwake.enabled}}" bindchange="onToggleKeepAwake" color="#2b6cf6" />
    </view>
    <view wx:if="{{keepAwake}}" class="muted" style="margin-top:8rpx;">
      {{keepAwake.active ? '当前持锁中' : '当前未持锁'}} · {{keepAwake.backend}}
    </view>
  </view>

  <!-- 标题行单独成卡是浪费：它只是标签，不是内容容器 -->
  <view class="section">
    <text class="card-title">会话</text>
    <text class="refresh" bindtap="refresh">{{refreshing ? '刷新中…' : '刷新'}}</text>
  </view>

  <view wx:if="{{sessions.length === 0}}" class="card">
    <view class="muted hint-empty">暂无会话。主机端有会话时会显示在这里。</view>
  </view>

  <view
    wx:for="{{sessions}}"
    wx:key="id"
    class="card session-item"
    data-id="{{item.id}}"
    data-title="{{item.title}}"
    bindtap="onOpen">
    <view class="session-head">
      <text wx:if="{{item.title}}" class="session-title">{{item.title}}</text>
      <text wx:else class="session-id">{{item.id}}</text>
      <text class="tag {{item.badgeCls}}">{{item.badgeText}}</text>
    </view>
    <view wx:if="{{item.workspace}}" class="session-meta">
      <text class="muted mono">{{item.workspace}}</text>
    </view>
    <view class="session-foot">
      <text class="mono">{{item.id}}</text>
      <text wx:if="{{item.updatedAt}}">{{item.updatedAt}}</text>
    </view>
  </view>
</view>
