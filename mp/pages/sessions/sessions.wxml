<view class="page-pad">

  <!-- 未配对：整个页面只剩一个动作 -->
  <block wx:if="{{!paired}}">
    <view class="pair-landing">
      <t-empty icon="link" description="还没有配对主机" />
      <t-button theme="primary" size="large" block bindtap="onGoPair">去配对</t-button>
    </view>
  </block>

  <block wx:else>
    <!-- 主机状态 -->
    <t-cell-group theme="card">
      <t-cell title="{{hostLabel || '主机'}}" description="{{statusText}}">
        <t-tag slot="note" theme="{{statusTheme}}" variant="light">{{statusLabel}}</t-tag>
      </t-cell>
      <t-cell title="防休眠" description="{{keepAwakeText}}">
        <t-switch slot="note" value="{{keepAwakeOn}}" bind:change="onToggleKeepAwake" disabled="{{status !== 'online'}}" />
      </t-cell>
    </t-cell-group>

    <view class="section-title">会话 · {{sessions.length}} 个</view>

    <t-empty wx:if="{{sessions.length === 0}}" icon="chat" description="暂无会话。主机端有会话时会显示在这里。" />

    <t-cell-group wx:else theme="card">
      <t-cell
        wx:for="{{sessions}}"
        wx:key="id"
        title="{{item.title}}"
        description="{{item.workspace || item.id}}"
        hover arrow
        data-id="{{item.id}}"
        data-title="{{item.title}}"
        bindtap="onOpen">
        <view slot="note" class="cell-note">
          <t-tag theme="{{item.badgeTheme}}" variant="light" size="small">{{item.badgeText}}</t-tag>
          <view wx:if="{{item.updatedAt}}" class="cell-time muted">{{item.updatedAt}}</view>
        </view>
      </t-cell>
    </t-cell-group>

    <view class="footer-link" bindtap="onGoPair">重新配对 / 高级设置</view>
  </block>
</view>
