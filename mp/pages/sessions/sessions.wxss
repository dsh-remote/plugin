/* sessions 页：组件之外只剩少量布局 */

.pair-landing {
  padding-top: 120rpx;
}

.cell-note {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
}

.cell-time {
  font-size: 20rpx;
}

.footer-link {
  margin-top: 48rpx;
  text-align: center;
  color: var(--td-brand-color, #0052d9);
  font-size: 26rpx;
  padding: 16rpx;
}
