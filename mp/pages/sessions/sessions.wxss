/* sessions 页：组件之外只剩少量布局。
   颜色一律走 TDesign 变量：主题按 prefers-color-scheme 自动切换，
   写死 #fff 的话在深色模式手机上会变成白底白字。 */

/* ── 未配对的落地页 ─────────────────────────────────────────────── */
.hero {
  padding-top: 48rpx;
}

.hero-mark {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  border-radius: 24rpx;
  background: var(--td-brand-color, #0052d9);
  color: var(--td-text-color-anti, #ffffff);
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 500;
}

.hero-desc {
  margin: 16rpx 8rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--td-text-color-secondary, #5c6470);
}

.hero-steps {
  padding: 12rpx 0;
}

.hero-step {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 24rpx;
}

.hero-num {
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--td-brand-color-1, #f2f3ff);
  color: var(--td-brand-color, #0052d9);
  font-size: 22rpx;
  font-weight: 500;
  margin-right: 16rpx;
}

.hero-text {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 26rpx;
  line-height: 40rpx;
}

.hero-note {
  margin-top: 24rpx;
  text-align: center;
}

.btn-gap {
  margin-top: 32rpx;
}

/* ── 主机卡 ─────────────────────────────────────────────────────── */
.host {
  padding: 28rpx;
}

.host-head {
  display: flex;
  align-items: center;
}

/* 颜色来自 app.wxss 的 .dot；这里只管间距 */
.host-head .dot {
  margin-right: 14rpx;
}

.host-name {
  flex: 1 1 auto;
  font-size: 32rpx;
  font-weight: 500;
}

.host-sub {
  margin: 12rpx 0 0 30rpx;
  font-size: 24rpx;
  color: var(--td-text-color-secondary, #5c6470);
}

.host-divider {
  height: 2rpx;
  margin: 26rpx 0;
  background: var(--td-component-border, #dcdcdc);
}

.host-keep {
  display: flex;
  align-items: center;
}

.host-keep-main {
  flex: 1 1 auto;
  min-width: 0;
}

.keep-title {
  font-size: 28rpx;
}

.keep-desc {
  margin-top: 4rpx;
}

/* ── 会话列表 ───────────────────────────────────────────────────── */
.section-title {
  display: flex;
  align-items: center;
}

.section-count {
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
  color: var(--td-text-color-placeholder, #a0a6b0);
}

.empty-card {
  padding: 32rpx 0 16rpx;
}

/* 归档会话被过滤掉时的一句说明（居中、弱化，别抢会话行的注意力） */
.hidden-note {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--td-text-color-placeholder, #a0a6b0);
}

.sess {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 24rpx 0;
}

.sess-line {
  height: 2rpx;
  margin-left: 30rpx;
  background: var(--td-component-border, #dcdcdc);
}

/* 色条贴左边框：圆角只给右侧，免得被卡片的 overflow:hidden 裁掉 */
.sess-bar {
  flex: 0 0 auto;
  width: 8rpx;
  height: 64rpx;
  border-radius: 0 8rpx 8rpx 0;
}

.sess-bar.primary { background: var(--td-brand-color, #0052d9); }
.sess-bar.warning { background: var(--td-warning-color, #e37318); }
.sess-bar.default { background: transparent; }

.sess-main {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 22rpx;
}

.sess-title {
  font-size: 30rpx;
  line-height: 42rpx;
}

.sess-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--td-text-color-placeholder, #a0a6b0);
}

.sess-right {
  flex: 0 0 auto;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.sess-badge {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  line-height: 32rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: var(--td-bg-color-secondarycontainer, #f3f3f3);
  color: var(--td-text-color-secondary, #5c6470);
}

.sess-badge.primary {
  background: var(--td-brand-color-1, #f2f3ff);
  color: var(--td-brand-color, #0052d9);
}

.sess-badge.warning {
  background: var(--td-warning-color-1, #fff1e9);
  color: var(--td-warning-color-6, #be5a00);
}

.sess-time {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--td-text-color-placeholder, #a0a6b0);
}

.pulse {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background: var(--td-text-color-secondary, #5c6470);
  animation: dot-blink 1.1s ease-in-out infinite;
}

.sess-badge.primary .pulse {
  background: var(--td-brand-color, #0052d9);
}
