/* index page —— 配对页（只有两件事：贴码/扫码、填 6 位码） */

.pair-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
}

.pair-hint.ok {
  color: #18a058;
}

.paste-input {
  font-size: 24rpx;
}

/* 6 位配对码：字距大 + 居中，但不能溢出，所以宽度锁死、字距随屏幕收敛 */
.code-input {
  letter-spacing: 8rpx;
  text-indent: 8rpx; /* 抵消 letter-spacing 造成的整体右偏 */
  text-align: center;
  font-size: 40rpx;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
}

.field-input {
  margin-top: 16rpx;
}

.btn-tight {
  margin-top: 24rpx;
}

/* 环境不可用时才出现的那张卡 */
.warn-card {
  border: 2rpx solid #f5c6c0;
}

/* 次要动作：不抢主按钮的注意力 */
.link {
  display: inline-block;
  color: #2b6cf6;
  font-size: 26rpx;
  padding: 12rpx 8rpx;
}

.link.center {
  display: block;
  text-align: center;
  margin-top: 24rpx;
}
