<view class="container">

  <!-- 容器没有 WebSocket 能力时，唯一要说的就是这一句 -->
  <view class="card warn-card" wx:if="{{!socketReady}}">
    <view class="card-title">当前环境无法连接</view>
    <view class="muted">
      这个运行环境没有 WebSocket（{{diagGlobal}}.connectSocket 不存在）。
      请用微信开发者工具或真机调试运行。
    </view>
    <text class="link" bindtap="onCopyDiag">复制诊断信息</text>
  </view>

  <!-- 状态 -->
  <view class="card">
    <view class="row-between">
      <text class="card-title">DSH 远程控制</text>
      <text wx:if="{{status === 'online'}}" class="tag tag-ok">已配对</text>
      <text wx:elif="{{status === 'connecting' || status === 'pairing'}}" class="tag tag-running">连接中</text>
      <text wx:elif="{{status === 'error'}}" class="tag tag-wait">异常</text>
      <text wx:else class="tag tag-idle">未配对</text>
    </view>
    <view class="muted" style="margin-top:12rpx;">{{statusText || '尚未连接'}}</view>
    <view wx:if="{{hostLabel}}" class="muted" style="margin-top:8rpx;">主机 {{hostLabel}}</view>
  </view>

  <!-- 已配对 -->
  <block wx:if="{{status === 'online'}}">
    <view class="btn" bindtap="onGoSessions">进入会话列表</view>
    <text class="link center" bindtap="onUnpair">解除配对</text>
  </block>

  <!-- 未配对 -->
  <block wx:else>
    <view class="card">
      <input
        class="input mono paste-input"
        placeholder="粘贴主机的二维码内容 dshr:/p?…"
        value="{{pasteText}}"
        bindinput="onPaste" />
      <view class="btn btn-tight" wx:if="{{scanReady}}" bindtap="onScan">扫码配对</view>
      <view class="muted pair-hint" wx:else>当前环境没有扫码能力，请粘贴下面的二维码内容</view>
      <view class="muted pair-hint" wx:if="{{!hasPsk}}">扫码或粘贴后会自动填入地址与密钥</view>
      <view class="muted pair-hint ok" wx:else>已获取密钥 ✓</view>
    </view>

    <view class="card">
      <input
        class="input code-input"
        type="number"
        maxlength="6"
        placeholder="6 位配对码"
        value="{{token}}"
        bindinput="onTokenInput" />
    </view>

    <view class="{{busy ? 'btn btn-disabled' : 'btn'}}" bindtap="onPair">
      {{busy ? '处理中…' : '开始配对'}}
    </view>

    <text class="link center" bindtap="toggleAdvanced">
      {{showAdvanced ? '收起高级设置' : '高级设置'}}
    </text>
    <view class="card" wx:if="{{showAdvanced}}">
      <input class="input field-input" placeholder="中继地址 wss://…" value="{{server}}" bindinput="onServerInput" />
      <input class="input mono field-input" placeholder="配对密钥 PSK" value="{{psk}}" bindinput="onPskInput" />
    </view>
    <!-- 出问题时要能一句话说清环境有什么，但平时不该占版面 -->
    <text class="link center dim" bindtap="onCopyDiag">复制环境自检</text>
  </block>
</view>
